# SERVER
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=https://mixxea.com

# SESSION
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# ADMIN CREDENTIALS
ADMIN_EMAIL=admin@mixxea.com
ADMIN_PASSWORD=MixxeaAdmin2025!
ADMIN_NOTIFY_EMAILS=admin@mixxea.com
CONTACT_NOTIFY_EMAILS=hello@yourdomain.com

# LEGACY SMTP FALLBACK (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Mixxea Records <info@mixxea.com>

# RESEND - PRIMARY EMAIL SYSTEM
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM_MIXXEA=Mixxea <no-reply@yourdomain.com>
EMAIL_FROM_FREQ_VAULT=Freq Vault <bookings@yourdomain.com>
EMAIL_FROM_ADMIN=Mixxea Control <ops@yourdomain.com>
BOOKING_NOTIFY_EMAILS=bookings@yourdomain.com
DEMO_NOTIFY_EMAILS=ar@yourdomain.com
NEWSLETTER_REPLY_TO=hello@yourdomain.com

# LABEL INFO
LABEL_NAME=Mixxea Records
AGENCY_NAME=FreqVault Agency
LABEL_EMAIL=info@mixxea.com
AR_EMAIL=ar@mixxea.com
BOOKINGS_EMAIL=bookings@freqvault.com

# FILE UPLOADS
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=200

# FUTURE BACKEND
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# DB_PATH=./data/mixxea.db
# DB_URL=postgresql://user:pass@localhost:5432/mixxea

SUPABASE_DB_SCHEMA=public
SUPABASE_STORAGE_ARTWORK_BUCKET=artwork
SUPABASE_STORAGE_AUDIO_BUCKET=audio
SUPABASE_STORAGE_CONTRACTS_BUCKET=contracts
SUPABASE_JWT_SECRET=your_jwt_secret_if_needed

