# SERVER
PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=https://www.mixxea.com
CANONICAL_BASE_URL=https://www.mixxea.com

# SESSION
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# ADMIN CREDENTIALS
# Login username for the admin panel (does not need to be a real mailbox)
ADMIN_LOGIN_EMAIL=admin-login@yourdomain.com
ADMIN_PASSWORD=change_this_admin_password
# Where admin notifications go (must be a real, monitored mailbox; comma-separated allowed)
ADMIN_NOTIFY_EMAIL=alerts@yourdomain.com
# Optional extra notification recipients (comma-separated)
# ADMIN_NOTIFY_EMAILS=
# Legacy: used for BOTH login and notifications only when the two vars above are unset
# ADMIN_EMAIL=
CONTACT_NOTIFY_EMAILS=hello@yourdomain.com

# LEGACY SMTP FALLBACK (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Mixxea Records <info@mixxea.com>

# RESEND - PRIMARY EMAIL SYSTEM
RESEND_API_KEY=your_resend_api_key
# Signing secret from the Resend webhook endpoint (starts with whsec_). Required for POST /api/webhooks/resend.
# RESEND_WEBHOOK_SECRET=
# Mailbox that receives bounce, complaint, suppression, and failed-delivery alerts. Defaults to hello@mixxea.com.
# BOUNCE_ALERT_EMAIL=hello@mixxea.com
EMAIL_FROM_MIXXEA=Mixxea <no-reply@yourdomain.com>
EMAIL_FROM_FREQ_VAULT=FreqVault · Mixxea <booking@mixxea.com>
EMAIL_FROM_ADMIN=Mixxea Control <ops@yourdomain.com>
BOOKING_NOTIFY_EMAILS=booking@mixxea.com
DEMO_NOTIFY_EMAILS=ar@yourdomain.com
NEWSLETTER_REPLY_TO=hello@yourdomain.com

# LABEL INFO
LABEL_NAME=Mixxea Records
AGENCY_NAME=FreqVault Agency
LABEL_EMAIL=info@mixxea.com
AR_EMAIL=ar@mixxea.com
BOOKINGS_EMAIL=booking@mixxea.com

# FILE UPLOADS
UPLOAD_DIR=./public/uploads
MAX_FILE_SIZE_MB=200

# FUTURE BACKEND
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_public_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# DB_PATH=./data/mixxea.db
# DB_URL=postgresql://user:pass@localhost:5432/mixxea

SUPABASE_DB_SCHEMA=public
SUPABASE_STORAGE_ARTWORK_BUCKET=artwork
SUPABASE_STORAGE_AUDIO_BUCKET=audio
SUPABASE_STORAGE_CONTRACTS_BUCKET=contracts
SUPABASE_JWT_SECRET=your_jwt_secret_if_needed

