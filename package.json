    "resend": "^6.10.0",
    "svix": "^1.88.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
